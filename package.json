{
	"name": "doyep-analyzer",
	"version": "0.0.0",
	"scripts": {
		"postinstall": "node tools/generate-config.mjs",
		"ng": "ng",
		"dev": "ng serve",
		"start": "ng serve",
		"prebuild": "ng build --project ngx-strava-client",
		"build": "ng build",
		"watch": "ng build --watch --configuration development",
		"watch:lib": "ng build --watch --configuration development --project ngx-strava-client",
		"test": "ng test"
	},
	"prettier": {
		"printWidth": 100,
		"singleQuote": true,
		"overrides": [
			{
				"files": "*.html",
				"options": {
					"parser": "angular"
				}
			}
		]
	},
	"private": true,
	"dependencies": {
		"@angular/common": "^21.0.5",
		"@angular/compiler": "^21.0.5",
		"@angular/core": "^21.0.5",
		"@angular/forms": "^21.0.5",
		"@angular/platform-browser": "^21.0.5",
		"@angular/router": "^21.0.5",
		"@tailwindcss/postcss": "^4.1.18",
		"postcss": "^8.5.6",
		"rxjs": "~7.8.2",
		"tailwindcss": "^4.1.18",
		"tslib": "^2.8.1"
	},
	"devDependencies": {
		"@angular/build": "^21.0.3",
		"@angular/cli": "^21.0.3",
		"@angular/compiler-cli": "^21.0.5",
		"@eslint/js": "^9.39.2",
		"@types/jasmine": "~5.1.13",
		"eslint": "^9.39.2",
		"globals": "^16.5.0",
		"jasmine-core": "~5.9.0",
		"jsdom": "^27.3.0",
		"ng-packagr": "^21.0.0",
		"postcss": "^8.5.3",
		"prettier": "3.6.2",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.49.0",
		"vitest": "^4.0.15"
	}
}
