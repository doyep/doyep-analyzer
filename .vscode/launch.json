{
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ng serve (Chrome)",
      "type": "pwa-chrome",
      "request": "launch",
      "preLaunchTask": "npm: watchlib and dev",
      "url": "http://localhost:4200/",
    },
    {
      "name": "ng test",
      "type": "pwa-chrome",
      "request": "launch",
      "preLaunchTask": "npm: test",
      "url": "http://localhost:9876/debug.html",
      "webRoot": "${workspaceFolder}",
      "runtimeArgs": [
        "--new-window",
        "--user-data-dir=${workspaceFolder}/.vscode/chrome-debug-test"
      ]
    }
  ]
}
